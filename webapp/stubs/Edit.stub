import { createFileRoute } from "@tanstack/react-router";
import { toast } from "sonner";
import { {{DummyResource}}Form } from "@/components/resources/{{dummy-resource}}/form";

export const Route = createFileRoute("/_protected/{{dummy-resource}}s/${{idName}}/alterar")({
  head: () => ({
    meta: [{ title: "Alterar {{DummyResourceName}}" }],
  }),
  component: RouteComponent,
});

function RouteComponent() {
  const params = Route.useParams();
  return (
    <div>
      <{{DummyResource}}Form
        id={params.{{idName}}}
        onSave={() => {
          toast.success("{{DummyResourceName}} alterad{{gender}}!");
        }}
      />
    </div>
  );
}
